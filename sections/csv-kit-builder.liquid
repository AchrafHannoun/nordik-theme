<script id="kit-builder-sku-variant-map-{{ section.id }}" type="application/json">
  {
    {%- assign products_for_map = collections[section.settings.collection_handle].products -%}
    {%- if products_for_map.size == 0 and section.settings.collection_handle != 'all' -%}
      {%- assign products_for_map = collections['all'].products -%}
    {%- endif -%}

    {%- assign first_item = true -%}
    {%- for product in products_for_map -%}
      {%- for variant in product.variants -%}
        {%- if variant.sku != blank -%}
          {%- unless first_item -%},{%- endunless -%}
          "{{ variant.sku | escape }}": {
            "variantId": {{ variant.id }},
            "title": "{{ product.title | escape }}",
            "productUrl": "{{ product.url | within: collection | default: product.url }}",
            {%- assign img_url = '' -%}
            {%- if variant.image -%}
              {%- assign img_url = variant.image | image_url: width: section.settings.results_image_width -%}
            {%- elsif product.featured_image -%}
              {%- assign img_url = product.featured_image | image_url: width: section.settings.results_image_width -%}
            {%- endif -%}
            "imageUrl": "{{ img_url | escape }}"
          }
          {%- assign first_item = false -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  }
</script>

