{% schema %}
{
  "name": "Iterative Kit Builder",
  "tag": "section",
  "class": "shopify-section-iterative-kit-builder",
  "settings": [
    {
      "type": "header",
      "content": "Data Source"
    },
    {
      "type": "text",
      "id": "csv_filename",
      "label": "CSV Filename (in Assets)",
      "default": "kit_builder_data.csv",
      "info": "Upload this CSV to Shopify Files (Content > Files)."
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Collection for SKU Mapping",
      "default": "all",
      "info": "Handle of the collection containing products for SKU-to-Variant ID mapping. Defaults to 'all' if not found or empty."
    },
    {
      "type": "text",
      "id": "skus_single_instance_in_cart",
      "label": "Single Instance SKUs",
      "info": "Comma-separated list of SKUs to add only once to the cart, with quantity from their first occurrence."
    },
    {
      "type": "header",
      "content": "Text Labels & Content"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Dropdown Placeholder",
      "default": "-- Select an Option --"
    },
    {
      "type": "textarea",
      "id": "summary_unit_template",
      "label": "Unit Summary Template",
      "default": "Unit #{unit_number}:\n{type} - {distance}\n{revetement}, {superficie}",
      "info": "Variables: {unit_number}, {type}, {distance}, {revetement}, {superficie}"
    },
    {
      "type": "text",
      "id": "title_step_unit_config_template",
      "label": "Unit Config Step Title Template",
      "default": "Configure Unit #{unit_number} - Type",
      "info": "Use {unit_number} for the current unit number."
    },
    {
      "type": "text",
      "id": "title_step_unit_details_template",
      "label": "Unit Details Step Title Template",
      "default": "Configure Unit #{unit_number} - {unit_type} Details",
      "info": "Use {unit_number} and {unit_type}."
    },
    {
      "type": "text",
      "id": "title_step_summary",
      "label": "Summary Step Title",
      "default": "Configuration Summary"
    },
    {
      "type": "text",
      "id": "title_step_results",
      "label": "Results Step Title",
      "default": "Your Custom Kit"
    },
    {
      "type": "text",
      "id": "label_unit_type",
      "label": "Label: Unit Type",
      "default": "Select Unit Type:"
    },
    {
      "type": "image_picker",
      "id": "image_label_unit_type",
      "label": "Image for 'Unit Type' Label"
    },
    {
      "type": "richtext",
      "id": "subtext_label_unit_type",
      "label": "Explanatory Text for 'Unit Type'"
    },
    {
      "type": "text",
      "id": "label_unit_type_maison",
      "label": "Label: Unit Type 'Maison (Generic)'",
      "default": "Maison (Autre)"
    },
    {
      "type": "text",
      "id": "label_unit_type_maison_sous_sol",
      "label": "Label: Unit Type 'Sous-Sol'",
      "default": "Maison (Sous-Sol)"
    },
    {
      "type": "text",
      "id": "label_unit_type_maison_rdj",
      "label": "Label: Unit Type 'Rez-de-Jardins'",
      "default": "Maison (Rez-de-Jardins)"
    },
    {
      "type": "text",
