{{ 'ensemble-quiz.css' | asset_url | stylesheet_tag }}

<style>
  #ensemble-quiz-{{ section.id }} {
    --quiz-section-bg: #FFFFFF;
    --quiz-card-bg: #FFFFFF;
    --quiz-card-border: #000000;
    --quiz-card-hover-bg: #f5f5f5;
    --quiz-card-selected-bg: #fdebed;
    --quiz-text-color: #000000;
    --quiz-muted-color: #222222;
    --quiz-accent: #D71F29;
    --quiz-btn-bg: #000000;
    --quiz-btn-text: #FFFFFF;
    --quiz-btn-hover-bg: #D71F29;
    --quiz-error-bg: #fdebed;
    --quiz-error-text: #D71F29;
    --quiz-success-bg: #f4f4f4;
    --quiz-success-text: #000000;
    --quiz-radius: {{ section.settings.card_border_radius }}px;
    --quiz-padding-top: {{ section.settings.section_padding_top }}px;
    --quiz-padding-bottom: {{ section.settings.section_padding_bottom }}px;
  }
</style>

<div
  id="ensemble-quiz-{{ section.id }}"
  class="ensemble-quiz"
  data-section-id="{{ section.id }}"
  data-csv-url="{{ section.settings.csv_filename | file_url }}"
  data-collection-handle="{{ section.settings.collection_handle | default: 'all' | escape }}"
  data-n8n-webhook-url="{{ section.settings.n8n_webhook_url | escape }}"
  data-show-building-question-when-single-option="{{ section.settings.show_building_question_when_single_option }}"
  data-quiz-title="{{ section.settings.quiz_title | escape }}"
  data-quiz-subtitle="{{ section.settings.quiz_subtitle | strip_html | escape }}"
  data-result-heading="{{ section.settings.result_heading | escape }}"
  data-email-form-heading="{{ section.settings.email_form_heading | escape }}"
  data-email-success-message="{{ section.settings.email_success_message | escape }}"
  data-email-error-message="{{ section.settings.email_error_message | escape }}"
  data-add-to-cart-btn-text="{{ section.settings.add_to_cart_btn_text | escape }}"
  data-send-pdf-btn-text="{{ section.settings.send_pdf_btn_text | escape }}"
  data-restart-btn-text="{{ section.settings.restart_btn_text | escape }}"
  data-back-btn-text="{{ section.settings.back_btn_text | escape }}"
  data-loading-text="{{ section.settings.loading_text | escape }}"
  data-no-match-text="{{ section.settings.no_match_text | escape }}"
  data-multiple-match-text="{{ section.settings.multiple_match_text | escape }}"
  data-no-products-text="{{ section.settings.no_products_text | escape }}"
  data-unresolved-variant-text="{{ section.settings.unresolved_variant_text | escape }}"
  data-add-to-cart-error-text="{{ section.settings.add_to_cart_error_text | escape }}"
  data-required-field-error-text="{{ section.settings.required_field_error_text | escape }}"
  data-label-building="{{ section.settings.label_building | escape }}"
  data-label-pipes="{{ section.settings.label_pipes_installed | escape }}"
  data-label-insulation="{{ section.settings.label_insulation | escape }}"
  data-label-diameter="{{ section.settings.label_diameter | escape }}"
  data-label-surface-9="{{ section.settings.label_surface_9 | escape }}"
  data-label-surface-12="{{ section.settings.label_surface_12 | escape }}"
  data-label-circuits="{{ section.settings.label_circuits | escape }}"
  data-label-energy="{{ section.settings.label_energy | escape }}"
  data-label-know-boiler="{{ section.settings.label_know_boiler | escape }}"
  data-label-boiler-model="{{ section.settings.label_boiler_model | escape }}"
  data-label-btu-range="{{ section.settings.label_btu_range | escape }}"
  data-label-fitting="{{ section.settings.label_fitting | escape }}"
  data-label-first-name="{{ section.settings.label_first_name | escape }}"
  data-label-last-name="{{ section.settings.label_last_name | escape }}"
  data-label-email="{{ section.settings.label_email | escape }}"
  data-placeholder-first-name="{{ section.settings.placeholder_first_name | escape }}"
  data-placeholder-last-name="{{ section.settings.placeholder_last_name | escape }}"
  data-placeholder-email="{{ section.settings.placeholder_email | escape }}"
  data-options-building="{{ section.settings.options_building | escape }}"
  data-options-pipes="{{ section.settings.options_pipes | escape }}"
  data-options-insulation="{{ section.settings.options_insulation | escape }}"
  data-options-diameter="{{ section.settings.options_diameter | escape }}"
  data-options-circuits="{{ section.settings.options_circuits | escape }}"
  data-options-energy="{{ section.settings.options_energy | escape }}"
  data-options-know-boiler="{{ section.settings.options_know_boiler | escape }}"
  data-options-fitting="{{ section.settings.options_fitting | escape }}"
  data-options-surface-9="{{ section.settings.options_surface_9 | escape }}"
  data-options-surface-12="{{ section.settings.options_surface_12 | escape }}"
  data-options-boiler-240="{{ section.settings.options_boiler_240 | escape }}"
  data-options-boiler-600="{{ section.settings.options_boiler_600 | escape }}"
  data-options-boiler-gaz-standard="{{ section.settings.options_boiler_gaz_standard | escape }}"
  data-options-boiler-gaz-combi="{{ section.settings.options_boiler_gaz_combi | escape }}"
  data-options-btu-240="{{ section.settings.options_btu_240 | escape }}"
  data-options-btu-600="{{ section.settings.options_btu_600 | escape }}"
  data-options-btu-gaz-standard="{{ section.settings.options_btu_gaz_standard | escape }}"
  data-options-btu-gaz-combi="{{ section.settings.options_btu_gaz_combi | escape }}"
>
  <div class="ensemble-quiz__inner page-width">
    <header class="ensemble-quiz__header">
      {% if section.settings.quiz_title != blank %}
        <h2 class="ensemble-quiz__title">{{ section.settings.quiz_title }}</h2>
      {% endif %}
      {% if section.settings.quiz_subtitle != blank %}
        <div class="ensemble-quiz__subtitle rte">{{ section.settings.quiz_subtitle }}</div>
      {% endif %}
    </header>

    <div id="ensemble-quiz-error-{{ section.id }}" class="ensemble-quiz__error" hidden></div>
    <div id="ensemble-quiz-app-{{ section.id }}" class="ensemble-quiz__app"></div>
  </div>

  <script id="ensemble-quiz-sku-variant-map-{{ section.id }}" type="application/json">
    {
      {%- assign products_for_map = collections[section.settings.collection_handle].products -%}
      {%- if products_for_map.size == 0 and section.settings.collection_handle != 'all' -%}
        {%- assign products_for_map = collections['all'].products -%}
      {%- endif -%}

      {%- assign first_item = true -%}
      {%- for product in products_for_map -%}
        {%- for variant in product.variants -%}
          {%- if variant.sku != blank -%}
            {%- unless first_item -%},{%- endunless -%}
            "{{ variant.sku | escape }}": {
              "variantId": {{ variant.id }},
              "title": "{{ product.title | escape }}",
              "productUrl": "{{ product.url | within: collection | default: product.url }}",
              {%- assign img_url = '' -%}
              {%- if variant.image -%}
                {%- assign img_url = variant.image | image_url: width: 240 -%}
              {%- elsif product.featured_image -%}
                {%- assign img_url = product.featured_image | image_url: width: 240 -%}
              {%- endif -%}
              "imageUrl": "{{ img_url | escape }}"
            }
            {%- assign first_item = false -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    }
  </script>
</div>

<script src="{{ 'ensemble-quiz.js' | asset_url }}" defer></script>

