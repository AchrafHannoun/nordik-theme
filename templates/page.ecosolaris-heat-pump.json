tgPFw","item_GU8FaL"],"settings":{"heading":"","heading_align":"text-center","icon_size":104,"title_type_scale":"extra_large","text_type_scale":"extra_large","icon_position":"above","mobile_stack":false,"section_height":"medium","color_scheme":"1","full_width":true,"dividers":"none","prevent_animation":false}},"promo_strip_4Gezm7":{"type":"promo-strip","blocks":{"button_3GMeze":{"type":"button","settings":{"button_label":"SHOP YOUR SOLAR HEAT PUMP","button_link":"shopify:\/\/collections\/heat-pumps","button_style":"btn btn--primary"}}},"block_order":["button_3GMeze"],"settings":{"section_height":"medium","color_scheme":"1","full_width":true,"dividers":"none","prevent_animation":false}},"icons_with_text_bCAPqg":{"type":"icons-with-text","blocks":{"item_Cgbzz7":{"type":"item","settings":{"icon":"truck","custom_icon":"shopify:\/\/shop_images\/hot-cool.png","heading":"Heating and Cooling","text":"<p>Versatile, it can both heat and cool to suit your requirements<\/p>","link":""}},"item_XDBnYC":{"type":"item","settings":{"icon":"price_tag","custom_icon":"shopify:\/\/shop_images\/checkmark.png","heading":"UL\/CSA\/Energy Star rated","text":"<p>Our solar heat pump is fully certified, making it a product you can count on.<\/p>","link":""}},"item_3HiCcC":{"type":"item","settings":{"icon":"return","custom_icon":"shopify:\/\/shop_images\/batterie.png","heading":"On-Grid and Off-Grid Rated","text":"<p>Use the grid at night or connect it to batteries if you're off-grid.<\/p>","link":""}}},"block_order":["item_Cgbzz7","item_XDBnYC","item_3HiCcC"],"settings":{"heading":"","heading_align":"text-start","icon_size":104,"title_type_scale":"extra_large","text_type_scale":"extra_large","icon_position":"above","mobile_stack":false,"section_height":"medium","color_scheme":"1","full_width":true,"dividers":"none","prevent_animation":false}},"image_banner_PxNcmV":{"type":"image-banner","settings":{"image_desktop":"shopify:\/\/shop_images\/how-ecosolaris-solar-air-conditioner-works.webp","url":"","height_mode":"auto","fixed_height_desktop":600,"fixed_height_mobile":350,"overlay_position":"justify-center items-center","overlay_text_align":"text-center","mob_center_text":false,"mobile_stacked":false,"color_scheme":"white","full_width":true,"transparent_content_color":"#ffffff","tint_color":"#000000","tint_opacity":0,"prevent_animation":false}},"media_with_text_ETU8WT":{"type":"media-with-text","blocks":{"text_RYrKWh":{"type":"text","settings":{"text":"<h5>4 DIFFERENT OPERATING MODES<\/h5><p>Our solar AC can operate in 4 different operating modes to meet your needs. <\/p><h5>SOLAR ONLY<\/h5><p>The solar ac unit will automatically adjust its speed and heating or cooling capacity to the available solar power. It will not work at night or when there is no sun. <\/p><p>Knowing that it works only with solar energy, it allows its user to realize more energy and monetary savings.<\/p><h5>HYBRID  (SOLAR\/GRID)<\/h5><p>The hybrid heat pump operates mainly on solar energy and is powered  by the electrical grid when needed. Typically, energy produced by solar panels is  used during sunny periods while the energy from the grid is used to make up the shortfall during non-sunny periods.<\/p><p>In this mode, the air conditionner will be able to operate day and night, as well as during periods when the sun is absent.<br\/><\/p><h5>GRID ONLY (SOLAR READY)<\/h5><p>The unit will work as any 240V AC standard air conditioner system but you will be able to add solar panels to it in the future if you want to. <\/p><p>In this mode, the air conditionner will be able to operate day and night, as well as during periods when the sun is absent.<\/p><h5>OFF-GRID<\/h5><p>A DC booster can be installed on the outdoor unit of the solar ac to make it off-grid. This booster makes it work with batteries.  <\/p><p>The solar ac unit can be powered by any 48V battery bank (lead-acid, AGM, Gel or lithium), meaning it can be installed on any solar energy system.<\/p><p>In this mode, the air conditioner will be able to operate day and night, as well as during periods when the sun is absent, if the battery storage capacity is sufficient.<\/p><h5>REMOTE CONTROL<\/h5><p>The solar heat pump connects to Wi-Fi: it can be remotely controlled using the Ecosolaris app (available free on iOS and Android). The app allows you to adjust the temperature, the fan speed and to program the unit. Optimizing energy consumption has never been easier.<\/p>","enlarge_text":false}}},"block_order":["text_RYrKWh"],"settings":{"image":"shopify:\/\/shop_images\/Solar-AC.jpg","video_external":"","video_description":"","video_autoplay":false,"layout":"left","image_fit":"cover","media_width":50,"media_scale":100,"text_align":"text-start","color_scheme":"none","only_content_color_scheme":false}},"video_tgr9bk":{"type":"video","settings":{"video_external":"https:\/\/youtu.be\/qWxidx6zwQo","video_description":"","poster_image":"shopify:\/\/shop_images\/ecosolaris-solar-air-ac-conditionner-unboxing-cover.webp","video_size":"md","video_autoplay":true,"text_align":"text-center","color_scheme":"1"}},"rich_text_ENGpMT":{"type":"rich-text","blocks":{"heading_3z9i4G":{"type":"heading","settings":{"heading":"Download","heading_size":"h2","heading_h1":false}},"text_htDwWc":{"type":"text","settings":{"text":"<p>Find everything you need for your Solar Heat Pump here.<\/p><ul><li><a href=\"https:\/\/ecosolaris.com\/wp-content\/uploads\/2024\/01\/Ecosolaris-Solar-Heat-Pump-Installation-Guide.pdf\">Installation manual<\/a><\/li><li><a href=\"https:\/\/ecosolaris.com\/wp-content\/uploads\/2024\/01\/Ecosolaris-Solar-Heat-Pump-User-Manual.pdf\">User manual <\/a><\/li><li><a href=\"https:\/\/ecosolaris.com\/wp-content\/uploads\/2024\/01\/Ecosolaris-Solar-Heat-Pump-Wifi-User-Manual.pdf\">Wi-Fi manual <\/a><\/li><li><a href=\"https:\/\/ecosolaris.com\/wp-content\/uploads\/2024\/01\/Ecosolaris-Solar-Heat-Pump-Remote-Controller-Instructions.pdf\">Remote controller manual <\/a><\/li><li><a href=\"https:\/\/apps.apple.com\/us\/app\/tuya-smart\/id1034649547\">App (iOS)<\/a><\/li><li><a href=\"https:\/\/play.google.com\/store\/apps\/details?id=com.tuya.smart\">App (Android)<\/a><\/li><li><a href=\"https:\/\/ecosolaris.com\/wp-content\/uploads\/2024\/02\/products-brochure-solar-heat-pump-ecosolaris-EN_WEB.pdf\">Spec sheet<\/a> <\/li><li><a href=\"https:\/\/oee.nrcan.gc.ca\/pml-lmp\/index.cfm?language_langue=en&ref=45367928&nr=1&action=app%2EformHandler&operation=details%2Ddetails&appliance=HP%5FSS%5F1P\" target=\"_blank\">NRCAN 18K Listing<\/a><\/li><li><a href=\"https:\/\/oee.nrcan.gc.ca\/pml-lmp\/index.cfm?action=app.formHandler&operation=details-details&ref=45367927&appliance=HP_SS_1P&nr=1\" target=\"_blank\">NRCAN 12K Listing<\/a><\/li><li><a href=\"https:\/\/www.energystar.gov\/productfinder\/product\/certified-central-heat-pumps\/results?formId=7689306-7889-448-6-6619176&scrollTo=617&search_text=ecosolaris&product_filter=&outdoorunitbrandname_isopen=1&is_most_efficient_filter=0&zip_code_filter=&product_types=Select+a+Product+Category&sort_by=max_seer2&sort_direction=desc&currentZipCode=5+29&page_number=0&lastpage=0&outdoorunitbrandname_filter=ECOSOLARIS\" target=\"_blank\">Energy Star Listings<\/a><\/li><\/ul>","enlarge_text":true}}},"block_order":["heading_3z9i4G","text_htDwWc"],"settings":{"text_position":"justify-center","text_align":"text-center","mob_center_text":true,"wide":false,"color_scheme":"none","full_width":true,"prevent_animation":false}},"product_comparison_grid_i7CkyV":{"type":"product-comparison-grid","blocks":{"product_FC7cQE":{"type":"product","settings":{"show_image":true,"show_title":true,"show_button":true}},"price_4jDbxQ":{"type":"price","settings":{}}},"block_order":["product_FC7cQE","price_4jDbxQ"],"settings":{"heading":"Our solar heat pump comes in two models to better suit your needs.","text":"","heading_align":"text-center","view_more_label":"View more","view_more_link":"","product_list":["solar-heat-pump-12-000-btu-energy-star-certified","solar-