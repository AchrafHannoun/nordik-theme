dicators.<\/p><ol><li><strong>1’’ FNTP isolation ball valve<\/strong><\/li><li><strong>Flowmeters<\/strong><\/li><li><strong>Air vent (supply and return side)<\/strong><\/li><li><strong>Thermometers (supply and return side)<\/strong><\/li><li><strong>1\/2\" Pex fittings included (can be optioannaly replaced with 3\/4’’, 3\/8’’ or 5\/8’’ fittings)<\/strong><\/li><li><strong>Balancing valve on each loop (replaceable by actuators)<\/strong><\/li><li><strong>Wall mounting bracket<\/strong><\/li><li><strong>Drain valves<\/strong><\/li><\/ol><p><strong>Note: <\/strong>The 1\/2\" Compression Connectors for 1\/2\" PEX are <strong>INCLUDED<\/strong>. <\/p><p>Can also be used with 3\/8'\", 5\/8'' and 3\/4\" PEX tubing with compression fitting sold separately<\/p>","enlarge_text":false}},"template--14742153560148__cb450dc6-8b3c-424c-beaa-5896d83e2750-button-1":{"type":"button","settings":{"button_label":"SHOP ALL NORDIK RADIANT MANIFOLDS","button_link":"https:\/\/b75156-2.myshopify.com\/collections\/manifolds","button_style":"btn btn--secondary"}}},"block_order":["template--14742153560148__cb450dc6-8b3c-424c-beaa-5896d83e2750-heading-1","template--14742153560148__cb450dc6-8b3c-424c-beaa-5896d83e2750-text-1","template--14742153560148__cb450dc6-8b3c-424c-beaa-5896d83e2750-button-1"],"settings":{"image":"{{ product.metafields.custom.product_detail_image_01.value }}","video_external":"","video_description":"","video_autoplay":false,"layout":"left","image_fit":"contain","media_width":50,"media_scale":100,"text_align":"text-start","color_scheme":"none","only_content_color_scheme":false}},"6d8e10c8-0e67-4b7b-bc4b-94b1629c7614":{"type":"promo-strip","blocks":{"template--14742153560148__6d8e10c8-0e67-4b7b-bc4b-94b1629c7614-heading-1":{"type":"heading","settings":{"heading":"8 possibles mounting positions","heading_size":"h4","show_on_mobile":true,"show_on_desktop":true}}},"block_order":["template--14742153560148__6d8e10c8-0e67-4b7b-bc4b-94b1629c7614-heading-1"],"settings":{"section_hei