a90fc0f73f8b":{"type":"logo","settings":{"image":"shopify:\/\/shop_images\/logo-salus.webp","url":"shopify:\/\/collections\/salus","logo_width":260,"text":""}},"logo_egQfRN":{"type":"logo","settings":{"image":"shopify:\/\/shop_images\/logo-copper-press.jpg","url":"shopify:\/\/collections\/copperpress-fittings","logo_width":190,"text":""}}},"block_order":["bef8cec6-6ad3-459e-bdf5-dba683549a81","7ef9f409-6c7c-47e5-bcf8-ed789c84a0fe","8b627e58-cb7e-4088-a1e5-23e17542ec20","logo_kACV8y","2f9c0c61-1c75-40e2-8769-a90fc0f73f8b","logo_egQfRN"],"settings":{"title":"","heading_align":"text-start","button_label":"","button_link":"","layout":"grid","spacing":40,"logo_grid_align":"justify-center","color_scheme":"none","full_width":true}},"promo_strip_etEXNc":{"type":"promo-strip","blocks":{"heading_YXpRVe":{"type":"heading","settings":{"heading":"Nordik Radiant – Your Hydronic Radiant Heating & Snow Melting Expert","heading_size":"h4","show_on_mobile":true,"show_on_desktop":true}}},"block_order":["heading_YXpRVe"],"settings":{"section_height":"small","color_scheme":"2","full_width":true,"dividers":"border-top","prevent_animation":false}},"rich_text_XNeLYm":{"type":"rich-text","blocks":{"text_pxFEnb":{"type":"text","settings":{"text":"<p>At Nordik Radiant, we specialize in the distribution and sale of hydronic radiant floor heating and snow melting system components (water\/glycol-based). We provide self-builders, plumbers, contractors, and electricians across Canada and the U.S. with all the essential components for efficient and long-lasting systems.<br\/><strong><br\/>Our Products & Solutions<\/strong><\/p><p>We offer a wide range of top-quality products from leading brands like Thermo 2000, Calefactio, Wilo, Grundfos, Caleffi, Viessmann, Tekmar, and Sinopé, including:<br\/><\/p><ul><li>PEX tubing<\/li><li>Electric & gas boilers<\/li><li>Manifolds<\/li><li>Actuators<\/li><li>Control relays<\/li><li>Circulator pumps<\/li><li>Smart thermostats<\/li><li><a href=\"\/pages\/nordik-radiant-hydronic-radiant-floor-kits\" title=\"Nordik Radiant Hydronic Radiant Floor Kits\">Complete kits<\/a> for the home and garage to simplify your purchasing process.<\/li><\/ul><p><br\/><strong>Why Choose Nordik Radiant?<\/strong><\/p><ul><li>Extensive inventory of premium products<\/li><li>Expert service for both professionals & homeowners<\/li><li>Online sizing tools (<a href=\"\/pages\/btu-calculator\" title=\"Btu Calculator\">BTU calculator<\/a>, <a href=\"\/pages\/pex-calculator\" title=\"PEX Calculator\">PEX calculator<\/a>, <a href=\"\/pages\/fluid-calculator\" title=\"Fluid Calculator\">glycol calculator<\/a>, etc.)<\/li><li>Fast shipping & dedicated customer support<\/li><li><a href=\"\/pages\/quote-request\" title=\"Quote Request\">Free quote<\/a><\/li><\/ul><p>Whether you're a professional looking for reliable solutions or a homeowner planning to install a hydronic heating or snow melting system, Nordik Radiant is your trusted partner! <\/p>","enlarge_text":false}}},"block_order":["text_pxFEnb"],"settings":{"text_position":"justify-center","text_align":"text-center","mob_center_text":true,"wide":false,"color_scheme":"none","full_width":true,"prevent_animation":false}},"featured_blog_RWXGR7":{"type":"featured-blog","disabled":true,"settings":{"title":"Most Recent Articles","heading_align":"text-center","show_view_all":false,"blog":"news","layout":"grid","posts_to_show":3,"show_featured_image":true,"show_tags":false,"show_excerpt":true,"show_author":false,"show_date":false,"show_button":false,"color_scheme":"none","image_ratio":"1.77","button_style":"btn btn--primary"}},"multi_column_8XL6hk":{"type":"multi-column","blocks":{"column_UAnt7B":{"type":"column","settings":{"enable_media":true,"image":"shopify:\/\/shop_images\/ice-snow-melting-cottage.jpg","media_scale":100,"heading":"Snow and ice melting systems","text":"<p>At Nordik Radiant, we specialize in hydronic heating. Based in the heart of Canada, in a climate where winter presents its challenges, we have developed particular expertise in an essential area: snow and ice melting. <br\/><br\/>In this article, we will delve into the issues, solutions, and benefits of snow and ice melting in detail, highlighting our accumulated expertise in this specific field over the years.<br\/><br\/><\/p>","button_label":"Read more...","button_link":"shopify:\/\/blogs\/news\/snow-and-ice-melting"}},"column_GzEFe3":{"type":"column","settings":{"enable_media":true,"image":"shopify:\/\/shop_images\/nordik-radiant-garage-noir-et-rouge.jpg","media_scale":100,"heading":"Streamline Your Heating Project with Our Hydronic Radiant Floor Kits for Garages","text":"<p>We are excited to announce the release of our brand-new offer of hydronic radiant floor kits for garages on our online store.<\/p><p>These kits will provide you the list of components needed for your project as well as a detailed price in just a few clicks. You can then place the order and have it delivered to your home or pick it up in-store.<\/p>","button_label":"Read more...","button_link":"shopify:\/\/blogs\/news\/hydronic-radiant-floor-garage-kits"}},"column_6Gdjhr":{"type":"column","settings":{"enable_media":true,"image":"shopify:\/\/shop_images\/thermo-2000-mini-bth-vs-mini-ultra-electric-boiler.jpg","media_scale":100,"heading":"Thermo 2000 electric boilers: Mini BTH Vs Mini Ultra","text":"<p>In the ever-evolving world of heating technology, homeowners and industry professionals are seeking reliable, efficient, and compact solutions to meet their heating needs. This is where Thermo 2000 Mini BTH and Mini Ultra boilers come into play, offering a combination of exceptional performance, compactness, and energy efficiency. <br\/><br\/>In this article, we delve into the features and benefits of these innovative boilers.<\/p>","button_label":"Read more...","button_link":"shopify:\/\/blogs\/news\/thermo-2000-electric-boilers-mini-bth-vs-mini-ultra"}},"column_Be4e7F":{"type":"column","settings":{"enable_media":true,"image":"shopify:\/\/shop_images\/blog-copperpress-press-fittings-jp.jpg","media_scale":100,"heading":"Nordik Radiant now offers CopperPress press fittings.","text":"<p>Since their introduction to the market, Press Fittings have profoundly transformed the plumbing industry. These innovative fittings offer an efficient and secure alternative to the traditional soldering method, thus redefining industry standards. <br\/><br\/>Nordik Radiant, a renowned company in the field of hydronic radiant floor heating, is proud to announce that it has recently integrated this technology into its online product offerings by providing<a href=\"https:\/\/nordikradiant.com\/collections\/copperpress-fittings\" title=\"Copper Press Fitting CopperPress\">CopperPress fittings<\/a>.<br\/><br\/><\/p>","button_label":"Read more...","button_link":"shopify:\/\/blogs\/news\/copperpress-press-fittings"}}},"block_order":["column_UAnt7B","column_GzEFe3","column_6Gdjhr","column_Be4e7F"],"name":"Multi-column","settings":{"title":"Most popular blog posts","heading_align":"text-start","button_label":"All blog posts","button_link":"shopify:\/\/blogs\/news","layout":"grid","column_size":"small","column_align":"left","media_align":"text-center","image_ratio":"1","color_scheme":"none","button_style":"btn btn--secondary"}},"1765978659b1328255":{"type":"apps","settings":{"full_width":false,"show_space":true}}},"order":["eb42d1d3-5d96-43f6-a770-d5954b7d1990","632402c9-4357-48f1-b470-3376c221c828","b04a492e-0ec8-4818-95f1-0fe04e3bb25c","cb436a49-03de-4524-a048-e5873c2a5f36","product_list_r6bbYA","197c37a0-c83c-4786-b64a-837860768b9b","0127e5e8-ab17-4eda-a75f-5b54afbb375b","promo_strip_yrHj7C","738b3f09-9964-457c-9638-d9be18ae23ef","385847a4-3c5d-4a60-bc58-ed689a41869a","promo_strip_etEXNc","rich_text_XNeLYm","featured_blog_RWXGR7","multi_column_8XL6hk","1765978659b1328255"]}