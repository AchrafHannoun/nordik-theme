e","mobile_stack":false,"section_height":"medium","color_scheme":"1","full_width":true,"dividers":"none","prevent_animation":false}},"icons_with_text_jGiVbj":{"type":"icons-with-text","blocks":{"item_dYKC4f":{"type":"item","settings":{"icon":"star","custom_icon":"shopify:\/\/shop_images\/black-star-icon.jpg","heading":"Flexible applications","text":"<p>Use for radiant heating, forced air, chilled panel and domestic hot water applications.<\/p>","link":""}},"item_yJUH6m":{"type":"item","settings":{"icon":"price_tag","custom_icon":"shopify:\/\/shop_images\/speaker-icon.jpg","heading":"Quiet operation","text":"<p>Maximum sound level at 3 ft distance is between 52 - 56 dB, depending on model.<\/p>","link":""}},"item_MbaaA4":{"type":"item","settings":{"icon":"return","custom_icon":"shopify:\/\/shop_images\/installation-ready-icon.jpg","heading":"Installation ready","text":"<p>Each Vitocal 100-AW system comes with installation fittings included.<\/p>","link":""}}},"block_order":["item_dYKC4f","item_yJUH6m","item_MbaaA4"],"settings":{"heading":"","heading_align":"text-start","icon_size":48,"title_type_scale":"medium","text_type_scale":"medium","icon_position":"beside","mobile_stack":false,"section_height":"medium","color_scheme":"1","full_width":true,"dividers":"none","prevent_animation":false}},"image_banner_yh7A84":{"type":"image-banner","settings":{"image_desktop":"shopify:\/\/shop_images\/vitocal_100-aw_life_1920x1080_86be5b47-dce6-4fe7-a2cb-4ec7401a609a.jpg","url":"","height_mode":"auto","fixed_height_desktop":600,"fixed_height_mobile":350,"overlay_position":"justify-center items-center","overlay_text_align":"text-center","mob_center_text":false,"mobile_stacked":false,"color_scheme":"white","full_width":true,"transparent_content_color":"#ffffff","tint_color":"#000000","tint_opacity":0,"prevent_animation":false}},"45063f41-8922-4141-a6f0-0de16ca0534e":{"type":"rich-text","blocks":{"5a77ea38-a780-43f2-b154-984ed2a70b24":{"type":"text","settings":{"text":"<h2>Vitocal 100-AW: The most accessible air-to-water heat pump solution in North America<\/h2><p>The Vitocal 100-AW is a true \"all-in-one kit\" with an outdoor unit, indoor unit and buffer tank. This provides for a fast and simple installation. The kit can be delivered on a single pallet for easy inventory, delivery, and jobsite ease.<\/p><h3>The easiest way to add heat pump hot water<\/h3><p>There is no reason to purchase a separate heat pump water heater with the available (optional) indirect-fired domestic storage tanks that save space and installation cost over other types of domestic hot water heating. The optional <a href=\"https:\/\/www.viessmann.ca\/en\/products\/vitocell\/vitocell-100-ve.html\">Vitocell 100-V<\/a> domestic indirect tanks come in three sizes. They are designed to pair with the Vitocal 100-AW, and the buffer tank can be physically mounted on top of the domestic tank to save space. A customer only needs to decide if they prefer 53, 66, or 79 gallons of domestic hot water storage.<\/p><h3>Simple set up and easy control<\/h3><p>The indoor unit has an integrated controller that can be run with continuous pumping and outdoor reset using the included sensors (outdoor, indoor, and tank sensors) with no thermostat needed in what Viessmann calls a \"European style\" system; or set it up North American style with a third party thermostat or with third party zone controller directly wired to the dry contacts on the unit.<\/p><h3>Flexible application types<\/h3><p>Vitocal 100-AW works in a variety of application types. Whether you want forced air heating and cooling or you are retrofitting a legacy radiant heating system – or a mix of both, these systems easily adapt to different heating and cooling strategies.<\/p>","enlarge_text":true}}},"block_order":["5a77ea38-a780-43f2-b154-984ed2a70b24"],"settings":{"text_position":"justify-center","text_align":"text-center","mob_center_text":true,"wide":false,"color_scheme":"none","full_width":true,"prevent_animation":false}},"image_banner_NK74xM":{"type":"image-banner","settings":{"image_desktop":"shopify:\/\/shop_images\/viessmann-vitocal-100-aw-real-life-setup.jpg","url":"","height_mode":"auto","fixed_height_desktop":600,"fixed_height_mobile":350,"overlay_position":"justify-center items-center","overlay_text_align":"text-center","mob_center_text":false,"mobile_stacked":false,"color_scheme":"white","full_width":true,"transparent_content_color":"#ffffff","tint_color":"#000000","tint_opacity":0,"prevent_animation":false}},"media_with_text_TcCztM":{"type":"media-with-text","blocks":{"heading_QynxDw":{"type":"heading","settings":{"heading":"Look inside the indoor unit","heading_size":"h3","heading_h1":false}},"text_XhrGCG":{"type":"text","settings":{"text":"<ol><li>Diverting valve<\/li><li>System pump<\/li><li>Electric heating element<\/li><li>Controller<\/li><li>Expansion tank<\/li><li>Dual fuel switch<\/li><li>Pump outputs<\/li><\/ol>","enlarge_text":true}}},"block_order":["heading_QynxDw","text_XhrGCG"],"settings":{"image":"shopify:\/\/shop_images\/viessmann-water-to-air-heat-pump-inside-view.jpg","video_external":"","video_description":"","video_autoplay":false,"layout":"left","image_fit":"contain","media_width":50,"media_scale":100,"text_align":"text-start","color_scheme":"none","only_content_color_scheme":false}},"media_with_text_WhUg8T":{"type":"media-with-text","blocks":{"heading_E8kXXR":{"type":"heading","settings":{"heading":"Look inside the outdoor unit","heading_size":"h3","heading_h1":false}},"text_iQJ6TG":{"type":"text","settings":{"text":"<ol><li>Dynamically balanced fan blade<\/li><li>Heavy gauge steel casing with baked enamel finish<\/li><li>Pre-charged with R32 refrigerant<\/li><li>Enhanced vapor injection (EVI) system<\/li><li>Refrigerant to water brazed plate heat exchanger<\/li><li>Robust inverter driven variable speed rotary compressor<\/li><li>Large evaporator coil with corrosion-resistant coating<\/li><li>Integrated control with Modbus for communication with indoor unit<\/li><\/ol>","enlarge_text":true}}},"block_order":["heading_E8kXXR","text_iQJ6TG"],"settings":{"image":"shopify:\/\/shop_images\/viessmann-water-to-air-heat-pump-outside-unit-interior-view.jpg","video_external":"","video_description":"","video_autoplay":false,"layout":"right","image_fit":"contain","media_width":50,"media_scale":100,"text_align":"text-start","color_scheme":"none","only_content_color_scheme":false}},"multi_column_qGnEc6":{"type":"multi-column","blocks":{"column_PKjELV":{"type":"column","settings":{"enable_media":false,"media_scale":100,"heading":"","text":"<ul><li>Fully electric low temperature heating with an output range of 20.5, 34.0 and 58.0 MBH for heating and 1.5, 3.0, and 4.3 tons for cooling<br\/><\/li><li>Suitable for both new construction and retrofit projects.<br\/><\/li><li>The kit can be delivered on a single pallet for easy inventory, delivery, and on-site convenience.<br\/><br\/><\/li><\/ul>","button_label":"","button_link":""}},"column_VmJeft":{"type":"column","settings":{"enable_media":false,"media_scale":100,"heading":"","text":"<ul><li>Indoor unit comes with integrated system pump and a digital controller with outdoor reset logic.<br\/><\/li><li>Pairs with Vitocell 100-V indirect-fired domestic hot water tanks.<br\/><\/li><li>Auxiliary electric heating elements integrated into the indoor unit. Can be paired with a furnace or boiler using the \"dual fuel switch\".<br\/><\/li><\/ul>","button_label":"","button_link":""}}},"block_order":["column_PKjELV","column_VmJeft"],"settings":{"title":"Advantages of the Vitocal 100-AW","heading_align":"text-center","button_label":"","button_link":"","layout":"grid","column_size":"medium","column_align":"left","media_align":"text-center","image_ratio":"1","color_scheme":"1","button_style":"btn btn--secondary"}},"video_46JpeH":{"type":"video","blocks":{"text_hcafWi":{"type":"text","settings":{"text":"<p>{{ product.metafields.custom.video_1_title.value }}<\/p>","enlarge_text":true}}},"block_order"